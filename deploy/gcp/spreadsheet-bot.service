# Modèle — installé par deploy/gcp/setup-vm.sh (User + chemins = utilisateur courant).
[Unit]
Description=SpreadsheetBot Discord bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=REPLACE_USER
WorkingDirectory=REPLACE_HOME/SpreadsheetBot
# .env is loaded by dotenv in src/config.ts — do not use EnvironmentFile= here:
# systemd cannot parse JSON values (GOOGLE_SERVICE_ACCOUNT_JSON) and breaks the private key.
ExecStart=/usr/bin/node REPLACE_HOME/SpreadsheetBot/dist/index.js
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
